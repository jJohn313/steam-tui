# ~/.config/steam_tui/config.env
# Steam TUI Configuration

# Optional: Provide your Steam Web API Key and SteamID64 for full IPlayerService synchronization
# You can obtain an API key at: https://steamcommunity.com/dev/apikey
# STEAM_API_KEY=""
# STEAM_ID64=""

# Terminal image preview via chafa (1 to enable, 0 to disable)
ENABLE_IMAGE_PREVIEW=1

# Image preview size for chafa (Width x Height)
CHAFA_SIZE=42x11
