#!/usr/bin/env bash

REAL_STEAM="/usr/bin/steam"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -x "${SCRIPT_DIR}/steam-tui-backend" ]]; then
    BACKEND="${SCRIPT_DIR}/steam-tui-backend"
else
    BACKEND="$HOME/.local/bin/steam-tui-backend"
fi

# Auto-recover from stale Steam FIFO pipes, PID locks, and headless ghost daemons
STEAM_PID_FILE="${HOME}/.steam/steam.pid"
STEAM_PIPE_FILE="${HOME}/.steam/steam.pipe"

if pgrep -u "$USER" -x "steam" >/dev/null 2>&1; then
    # If steam is running but steamwebhelper is missing and no game is active, kill the ghost
    if ! pgrep -u "$USER" -x "steamwebhelper" >/dev/null 2>&1; then
        if ! "$BACKEND" --has-running >/dev/null 2>&1; then
            pkill -u "$USER" -9 -x "steam" 2>/dev/null
            rm -f "$STEAM_PID_FILE" "$STEAM_PIPE_FILE" "${HOME}/.local/share/Steam/steam.pid" "${HOME}/.local/share/Steam/steam.pipe"
        fi
    fi
fi

if [[ -f "$STEAM_PID_FILE" ]]; then
    OLD_PID=$(cat "$STEAM_PID_FILE" 2>/dev/null)
    if [[ -n "$OLD_PID" ]] && ! kill -0 "$OLD_PID" 2>/dev/null; then
        rm -f "$STEAM_PID_FILE" "$STEAM_PIPE_FILE" "${HOME}/.local/share/Steam/steam.pid" "${HOME}/.local/share/Steam/steam.pipe"
    fi
elif [[ -p "$STEAM_PIPE_FILE" ]]; then
    if ! pgrep -u "$USER" -x "steam" >/dev/null 2>&1; then
        rm -f "$STEAM_PIPE_FILE" "${HOME}/.local/share/Steam/steam.pipe"
    fi
fi

# 1. Passthrough: Explicit GUI launch & file management helpers
if [[ "$1" == "--gui" || "$1" == "-gui" ]]; then
    exec "$BACKEND" --open-gui
elif [[ "$1" == "--files" || "$1" == "-f" ]]; then
    shift
    exec "$BACKEND" --files-menu "$@"
elif [[ "$1" == "--open-dir" || "$1" == "--browse" ]]; then
    shift
    exec "$BACKEND" --open-dir "$@"
elif [[ "$1" == "--open-saves" || "$1" == "--saves" ]]; then
    shift
    exec "$BACKEND" --open-saves "$@"
elif [[ $# -gt 0 ]]; then
    if ! pgrep -u "$USER" -x "steam" >/dev/null 2>&1; then
        "$BACKEND" --ensure-daemon >/dev/null 2>&1
    fi
    exec "$REAL_STEAM" "$@"
fi

# 2. If non-interactive (no TTY) and no args: pass straight to REAL_STEAM so background scripts don't trigger --open-gui's -shutdown!
if [[ ! -t 0 || ! -t 1 ]]; then
    exec "$REAL_STEAM" "$@"
fi

# 3. Active Session Check: If a game is already running, show persistent dashboard first!
if "$BACKEND" --has-running; then
    "$BACKEND" --dashboard
    DASH_STATUS=$?
    # Exit code 2 means user pressed 'b' to browse library
    if [[ $DASH_STATUS -ne 2 ]]; then
        exit 0
    fi
fi

# 4. Interactive Library & Persistent Session Loop
while true; do
    GAME_LIST=$("$BACKEND" --list)

    if [[ -z "$GAME_LIST" ]]; then
        echo "No Steam games found. Starting native Steam client..."
        exec "$REAL_STEAM"
    fi

    # Run fzf with Kitty-optimized styling and preview pane
    RAW_OUT=$(echo "$GAME_LIST" | fzf \
        --expect=ctrl-s,ctrl-z \
        --delimiter=$'\t' \
        --with-nth=1 \
        --ansi \
        --layout=reverse \
        --border=rounded \
        --border-label=" 🎮 STEAM HEADLESS TUI " \
        --border-label-pos=3 \
        --info=inline-right \
        --prompt=" Search ❯ " \
        --pointer="▶" \
        --color="bg+:#1e1e2e,fg+:#cdd6f4,hl:#f38ba8,hl+:#f38ba8,border:#89b4fa,label:#89b4fa,prompt:#cba6f7,pointer:#f5e0dc,header:#6c7086" \
        --header="ENTER: Launch │ Ctrl-F: Files & Saves │ Ctrl-O: Launch Options │ Ctrl-P: Proton │ Ctrl-S: Steam │ Ctrl-Z: Shim" \
        --preview="$BACKEND --preview {2} {3}" \
        --preview-window="right:48%:border-left:wrap" \
        --bind="ctrl-r:reload($BACKEND --sync >/dev/null 2>&1 && $BACKEND --list)" \
        --bind="ctrl-i:reload($BACKEND --list | grep -E 'INSTALLED|UPDATE|SHORTCUT')" \
        --bind="ctrl-a:reload($BACKEND --list)" \
        --bind="ctrl-o:execute($BACKEND --edit-launch-options {2})+reload($BACKEND --list)" \
        --bind="ctrl-p:execute($BACKEND --set-proton {2})+reload($BACKEND --list)" \
        --bind="ctrl-f:execute($BACKEND --files-menu {2})" \
        --bind="ctrl-x:execute($BACKEND --uninstall {2})+reload($BACKEND --list)" \
        --height=92%)

    KEY_PRESSED=$(echo "$RAW_OUT" | head -n 1)
    SELECTED=$(echo "$RAW_OUT" | tail -n +2)

    if [[ -z "$SELECTED" ]]; then
        exit 0
    fi

    APPID=$(echo "$SELECTED" | awk -F'\t' '{print $2}' | tr -d '\r\n')
    STATUS=$(echo "$SELECTED" | awk -F'\t' '{print $3}' | tr -d '\r\n')
    SHORTCUT_ID=$(echo "$SELECTED" | awk -F'\t' '{print $4}' | tr -d '\r\n')
    NAME=$(echo "$SELECTED" | awk -F'\t' '{print $1}' | sed -E 's/\x1b\[[0-9;]*m//g' | sed 's/^\[.*\] *//')

    if [[ "$STATUS" == "SHORTCUT" ]]; then
        "$BACKEND" --launch-and-monitor "$APPID" "$SHORTCUT_ID"
        continue
    fi

    if [[ "$STATUS" == "AVAILABLE" ]]; then
        read -r -p "Install $NAME in terminal? [y/N] " confirm
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            "$BACKEND" --install "$APPID"
        else
            echo "Installation cancelled."
        fi
        continue
    fi

    # Persistent Launch & Session Monitor!
    # Handles update progress bar, background shader compilation, and live game session dashboard.
    EXTRA_FLAG=""
    if [[ "$KEY_PRESSED" == "ctrl-s" ]]; then
        EXTRA_FLAG="--official"
    elif [[ "$KEY_PRESSED" == "ctrl-z" ]]; then
        EXTRA_FLAG="--shim"
    fi

    "$BACKEND" --launch-and-monitor "$APPID" "" $EXTRA_FLAG

    echo ""
    read -r -p "Return to Game Library? [Y/n] " ret
    if [[ "$ret" =~ ^[Nn]$ ]]; then
        break
    fi
done
