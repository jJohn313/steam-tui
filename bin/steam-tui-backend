#!/usr/bin/env python3
"""
Steam Terminal UI (TUI) Backend
Manages Steam library discovery, owned games caching, fzf formatting, and previews.
"""

import sys
import os
import re
import json
import struct
import glob
import subprocess
import shutil
import urllib.request
import urllib.parse
import signal
from datetime import datetime

STEAM_ROOT = os.path.expanduser("~/.local/share/Steam")
CACHE_DIR = os.path.expanduser("~/.cache/steam_tui")
CACHE_FILE = os.path.join(CACHE_DIR, "owned_cache.json")
CONFIG_DIR = os.path.expanduser("~/.config/steam_tui")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.env")
REAL_STEAM = "/usr/bin/steam"

def get_steam_env(headless=True):
    """Dynamically set Steam environment for Vanilla vs Millennium setups."""
    env = dict(os.environ)
    mill_path = os.path.expanduser("~/.local/lib/millennium/libmillennium_x86.so")
    if not os.path.isfile(mill_path):
        return env

    if not headless:
        env["MILLENNIUM_RUNTIME_PATH"] = mill_path
    else:
        env.pop("MILLENNIUM_RUNTIME_PATH", None)
        # Preload native 32-bit libXtst.so.6 before Millennium proxy in ubuntu12_32
        for cand in [
            "/usr/lib32/libXtst.so.6",
            os.path.expanduser("~/.local/share/Steam/ubuntu12_32/steam-runtime/usr/lib/i386-linux-gnu/libXtst.so.6"),
        ]:
            if os.path.isfile(cand):
                curr = env.get("LD_PRELOAD", "")
                env["LD_PRELOAD"] = f"{cand}:{curr}" if curr else cand
                break
    return env

def get_steam_pss_mb():
    """Calculate true unique physical memory (PSS) of Steam and CEF helpers in MB."""
    total_pss_kb = 0
    pids = set()
    for pattern in ["steam", "steamwebhelper"]:
        try:
            out = subprocess.check_output(["pgrep", pattern], stderr=subprocess.DEVNULL).decode().split()
            for p in out:
                pids.add(p.strip())
        except Exception:
            pass
    pids.discard(str(os.getpid()))
    for pid in pids:
        try:
            with open(f"/proc/{pid}/smaps_rollup", "r") as f:
                for line in f:
                    if line.startswith("Pss:"):
                        total_pss_kb += int(line.split()[1])
                        break
        except Exception:
            pass
    return max(0, total_pss_kb // 1024)

FILTER_KEYWORDS = [
    "proton",
    "steam linux runtime",
    "steamworks common redistributables",
    "steamvr",
    "soundtrack",
    "steam controller",
    "shared depots",
    "steam dedicated server",
    "source sdk",
    "steam client",
    "winui2",
]

def load_config():
    """Load configuration from ~/.config/steam_tui/config.env"""
    cfg = {
        "STEAM_API_KEY": "",
        "STEAM_ID64": "",
        "ENABLE_IMAGE_PREVIEW": "1",
        "CHAFA_SIZE": "42x11",
    }
    if os.path.isfile(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#") or "=" not in line:
                        continue
                    k, v = line.split("=", 1)
                    k = k.strip()
                    v = v.strip().strip("\"'")
                    cfg[k] = v
        except Exception:
            pass
    return cfg

def is_filtered(name, app_type="game"):
    """Filter out runtime packages, tools, soundtracks, DLCs, and non-games."""
    name_l = name.lower()
    if any(k in name_l for k in FILTER_KEYWORDS):
        return True
    if app_type.lower() in ("tool", "config", "dlc", "music", "application", "hardware"):
        return True
    return False

def get_library_folders():
    """Discover all mounted Steam library paths across all drives."""
    paths = {STEAM_ROOT}
    vdf_path = os.path.join(STEAM_ROOT, "steamapps", "libraryfolders.vdf")
    if os.path.isfile(vdf_path):
        try:
            with open(vdf_path, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read()
            for m in re.finditer(r'\"path\"\s+\"([^\"]+)\"', content):
                p = m.group(1).replace("\\\\", "/")
                if os.path.isdir(p):
                    paths.add(p)
        except Exception:
            pass
    return sorted(list(paths))

def parse_acf_file(manifest_path):
    """Parse a single appmanifest_<appid>.acf file."""
    try:
        with open(manifest_path, "r", encoding="utf-8", errors="ignore") as f:
            content = f.read()
    except Exception:
        return None

    appid_m = re.search(r'\"appid\"\s+\"(\d+)\"', content)
    name_m = re.search(r'\"name\"\s+\"([^\"]+)\"', content)
    if not appid_m or not name_m:
        return None

    appid = appid_m.group(1)
    name = name_m.group(1)

    installdir_m = re.search(r'\"installdir\"\s+\"([^\"]+)\"', content)
    size_m = re.search(r'\"SizeOnDisk\"\s+\"(\d+)\"', content)
    last_played_m = re.search(r'\"LastPlayed\"\s+\"(\d+)\"', content)

    installdir = installdir_m.group(1) if installdir_m else ""
    size = int(size_m.group(1)) if size_m else 0
    last_played = int(last_played_m.group(1)) if last_played_m else 0

    state_flags_m = re.search(r'\"StateFlags\"\s+\"(\d+)\"', content)
    bytes_to_download_m = re.search(r'\"BytesToDownload\"\s+\"(\d+)\"', content)
    bytes_downloaded_m = re.search(r'\"BytesDownloaded\"\s+\"(\d+)\"', content)
    bytes_to_stage_m = re.search(r'\"BytesToStage\"\s+\"(\d+)\"', content)
    bytes_staged_m = re.search(r'\"BytesStaged\"\s+\"(\d+)\"', content)

    state_flags = int(state_flags_m.group(1)) if state_flags_m else 4
    bytes_to_download = int(bytes_to_download_m.group(1)) if bytes_to_download_m else 0
    bytes_downloaded = int(bytes_downloaded_m.group(1)) if bytes_downloaded_m else 0
    bytes_to_stage = int(bytes_to_stage_m.group(1)) if bytes_to_stage_m else 0
    bytes_staged = int(bytes_staged_m.group(1)) if bytes_staged_m else 0

    return {
        "appid": appid,
        "name": name,
        "installdir": installdir,
        "size": size,
        "last_played": last_played,
        "manifest_path": manifest_path,
        "state_flags": state_flags,
        "bytes_to_download": bytes_to_download,
        "bytes_downloaded": bytes_downloaded,
        "bytes_to_stage": bytes_to_stage,
        "bytes_staged": bytes_staged,
    }

def get_installed_games():
    """Scan all library folders for installed games."""
    installed = {}
    for lib_path in get_library_folders():
        steamapps_dir = os.path.join(lib_path, "steamapps")
        if not os.path.isdir(steamapps_dir):
            continue
        for manifest_path in glob.glob(os.path.join(steamapps_dir, "appmanifest_*.acf")):
            app = parse_acf_file(manifest_path)
            if not app:
                continue
            if is_filtered(app["name"]):
                continue
            app["library"] = lib_path
            app["install_path"] = os.path.join(steamapps_dir, "common", app["installdir"])
            installed[app["appid"]] = app
    return installed

def parse_appinfo_vdf():
    """Parse Steam's local binary appinfo.vdf cache for app metadata (v28/v29 support)."""
    appinfo_path = os.path.join(STEAM_ROOT, "appcache", "appinfo.vdf")
    apps = {}
    if not os.path.isfile(appinfo_path):
        return apps

    try:
        with open(appinfo_path, "rb") as f:
            raw = f.read()
    except Exception:
        return apps

    if len(raw) < 16:
        return apps

    magic, universe = struct.unpack("<II", raw[:8])
    if magic in (0x07564428, 0x07564429):
        str_offset = struct.unpack("<Q", raw[8:16])[0]
        offset = 16
        app_header_size = 68
    else:
        str_offset = len(raw)
        offset = 8
        app_header_size = 48

    name_token = b"\x01\x04\x00\x00\x00"
    type_token = b"\x01\x05\x00\x00\x00"
    if magic == 0x07564429 and str_offset < len(raw):
        try:
            num_strings = struct.unpack("<I", raw[str_offset:str_offset+4])[0]
            pos = str_offset + 4
            str_pool = {}
            for i in range(num_strings):
                end = raw.find(b"\x00", pos)
                if end == -1:
                    break
                s = raw[pos:end].decode("utf-8", "ignore")
                str_pool[s] = i
                pos = end + 1
            if "name" in str_pool:
                name_token = b"\x01" + struct.pack("<I", str_pool["name"])
            if "type" in str_pool:
                type_token = b"\x01" + struct.pack("<I", str_pool["type"])
        except Exception:
            pass

    raw_len = min(len(raw), str_offset)
    while offset < raw_len - 8:
        appid, size = struct.unpack("<II", raw[offset:offset+8])
        if appid == 0:
            break
        chunk = raw[offset+app_header_size : offset+size+8]
        offset += size + 8

        m_name = re.search(re.escape(name_token) + b"([^\x00]+)\x00", chunk)
        if not m_name:
            m_name = re.search(b"\x01name\x00([^\x00]+)\x00", chunk, re.IGNORECASE)

        if m_name:
            name = m_name.group(1).decode("utf-8", errors="replace")
            m_type = re.search(re.escape(type_token) + b"([^\x00]+)\x00", chunk)
            if not m_type:
                m_type = re.search(b"\x01type\x00([^\x00]+)\x00", chunk, re.IGNORECASE)
            app_type = m_type.group(1).decode("utf-8", errors="replace") if m_type else "game"
            apps[str(appid)] = {"name": name, "type": app_type}

    return apps

def get_non_steam_shortcuts():
    """Parse shortcuts.vdf across all userdata directories."""
    shortcuts = {}
    for p in glob.glob(os.path.join(STEAM_ROOT, "userdata/*/config/shortcuts.vdf")):
        try:
            with open(p, "rb") as f:
                raw = f.read()

            def parse_binary_kv(buf, pos=0):
                res = {}
                while pos < len(buf):
                    t = buf[pos]
                    pos += 1
                    if t == 8:
                        break
                    key_end = buf.find(b"\x00", pos)
                    if key_end == -1:
                        break
                    key = buf[pos:key_end].decode("utf-8", "ignore")
                    pos = key_end + 1
                    if t == 0:
                        val, pos = parse_binary_kv(buf, pos)
                        res[key] = val
                    elif t == 1:
                        val_end = buf.find(b"\x00", pos)
                        val = buf[pos:val_end].decode("utf-8", "ignore")
                        pos = val_end + 1
                        res[key] = val
                    elif t == 2:
                        val = struct.unpack("<I", buf[pos:pos+4])[0]
                        pos += 4
                        res[key] = val
                    else:
                        break
                return res, pos

            data, _ = parse_binary_kv(raw)
            sc_dict = data.get("shortcuts", {})
            for idx, sc in sc_dict.items():
                aid = sc.get("appid", 0)
                name = sc.get("AppName", sc.get("appname", "Shortcut"))
                exe = sc.get("Exe", sc.get("exe", ""))
                startdir = sc.get("StartDir", sc.get("startdir", ""))
                opts = sc.get("LaunchOptions", sc.get("launchoptions", ""))
                sc_id_64 = (aid << 32) | 0x02000000
                shortcuts[str(aid)] = {
                    "name": name,
                    "appid": str(aid),
                    "shortcut_id": str(sc_id_64),
                    "exe": exe,
                    "startdir": startdir,
                    "launch_options": opts,
                }
        except Exception:
            pass
    return shortcuts

def get_game_name(appid):
    """Retrieve friendly name for Steam app or shortcut."""
    installed = get_installed_games()
    if str(appid) in installed:
        return installed[str(appid)]["name"]
    shortcuts = get_non_steam_shortcuts()
    if str(appid) in shortcuts:
        return shortcuts[str(appid)]["name"]
    owned = load_owned_cache()
    if str(appid) in owned:
        return owned[str(appid)].get("name", f"App {appid}")
    return f"App {appid}"

def get_cloud_save_status(appid):
    """Fetch cloud synchronization timestamp and status from remotecache.vdf."""
    for p in glob.glob(os.path.join(STEAM_ROOT, "userdata/*", str(appid), "remotecache.vdf")):
        try:
            with open(p, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read()
            m_time = re.search(r'\"(?:remotetime|time)\"\s+\"(\d+)\"', content)
            m_sync = re.search(r'\"syncstate\"\s+\"(\d+)\"', content)
            if m_time:
                ts = int(m_time.group(1))
                if ts > 100000000:
                    dt = datetime.fromtimestamp(ts)
                    state = "Synced" if (m_sync and m_sync.group(1) == "1") else "Local"
                    return f"{state} ({dt.strftime('%Y-%m-%d %H:%M')})"
        except Exception:
            pass
    return "Local / Not Synced"

def get_compat_tool(appid):
    """Fetch current Proton or runtime compatibility tool mapping."""
    cfg_path = os.path.join(STEAM_ROOT, "config", "config.vdf")
    if os.path.isfile(cfg_path):
        try:
            with open(cfg_path, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read()
            m = re.search(r'\"' + str(appid) + r'\"[\s\n]*\{[^}]*\"name\"\s+\"([^\"]+)\"', content)
            if m:
                return m.group(1)
        except Exception:
            pass
    for lib in get_library_folders():
        if os.path.isdir(os.path.join(lib, "steamapps", "compatdata", str(appid))):
            return "Proton (Default/Auto)"
    return "Native Linux"

def get_available_proton_tools():
    """Discover installed Proton versions and custom compatibility tools."""
    tools = []
    for d in glob.glob(os.path.expanduser("~/.local/share/Steam/compatibilitytools.d/*")):
        if os.path.isdir(d):
            tools.append((os.path.basename(d), f"Custom: {os.path.basename(d)}"))
    for d in glob.glob("/usr/share/steam/compatibilitytools.d/*"):
        if os.path.isdir(d):
            tools.append((os.path.basename(d), f"System: {os.path.basename(d)}"))

    tools.append(("proton_experimental", "Valve: Proton Experimental"))
    tools.append(("proton_hotfix", "Valve: Proton Hotfix"))

    for lib in get_library_folders():
        for p in glob.glob(os.path.join(lib, "steamapps", "common", "Proton*")):
            b = os.path.basename(p)
            m_ver = re.search(r'Proton\s+(\d+(?:\.\d+)?)', b)
            if m_ver:
                tool_id = f"proton_{m_ver.group(1).replace('.', '_')}"
                if (tool_id, f"Valve: {b}") not in tools:
                    tools.append((tool_id, f"Valve: {b}"))

    tools.append(("", "Default (Valve auto-selection or Native)"))
    return tools

def ensure_steam_stopped_for_vdf_edit():
    """Ensure idle Steam daemon is shut down before editing .vdf configs to prevent Steam overwriting them."""
    import time
    if get_running_steam_game():
        print("\033[1;33mWarning: A game is currently running. Steam config edits may be overwritten.\033[0m")
        return False
    res = subprocess.run(["pgrep", "-x", "steam"], stdout=subprocess.DEVNULL)
    if res.returncode == 0:
        print("\033[1;34mStopping idle Steam to safely edit configuration...\033[0m")
        subprocess.run([REAL_STEAM, "-shutdown"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(20):
            time.sleep(0.5)
            if subprocess.run(["pgrep", "-x", "steam"], stdout=subprocess.DEVNULL).returncode != 0:
                break
        cleanup_stale_steam_locks()
        return True
    return False

def edit_launch_options(appid):
    """Interactively view or modify per-game LaunchOptions in localconfig.vdf."""
    ensure_steam_stopped_for_vdf_edit()
    name = get_game_name(appid)
    lconfs = glob.glob(os.path.join(STEAM_ROOT, "userdata/*/config/localconfig.vdf"))
    if not lconfs:
        print(f"\n\033[1;31mError: localconfig.vdf not found in Steam userdata.\033[0m")
        return

    lconf_path = lconfs[0]
    with open(lconf_path, "r", encoding="utf-8", errors="ignore") as f:
        content = f.read()

    cur_opts = ""
    app_pat = r'(\"' + str(appid) + r'\"\s*\{)([^}]*)'
    m = re.search(app_pat, content)
    if m:
        body = m.group(2)
        m_opts = re.search(r'\"LaunchOptions\"\s+\"([^\"]*)\"', body)
        if m_opts:
            cur_opts = m_opts.group(1)

    print("\n" + "=" * 65)
    print(f"  ⚙️  Launch Options for \033[1;36m{name}\033[0m (AppID: {appid})")
    print("=" * 65)
    if cur_opts:
        print(f"Current: \033[1;33m{cur_opts}\033[0m\n")
    else:
        print("Current: \033[2m[None (using default)]\033[0m\n")

    print("\033[2mExamples:\033[0m")
    print("  gamemoderun %command%")
    print("  ENABLE_HDR_WSI=1 gamescope -W 3440 -H 1440 -r 175 --hdr-enabled -- %command%")
    print("  PROTON_ENABLE_NVAPI=1 %command%\n")
    print("Type new options below, type \033[1;31mclear\033[0m to remove, or press \033[1mENTER\033[0m to cancel:")
    try:
        new_opts = input("❯ ").strip()
    except (KeyboardInterrupt, EOFError):
        return

    if not new_opts:
        print("No changes made.")
        import time; time.sleep(0.8)
        return

    if new_opts.lower() == "clear":
        new_opts = ""

    if m:
        body = m.group(2)
        if re.search(r'\"LaunchOptions\"\s+\"[^\"]*\"', body):
            new_body = re.sub(r'\"LaunchOptions\"\s+\"[^\"]*\"', f'"LaunchOptions"\t\t"{new_opts}"', body)
        elif new_opts:
            new_body = f'\n\t\t\t\t\t\t"LaunchOptions"\t\t"{new_opts}"' + body
        else:
            new_body = body
        new_content = content[:m.start(2)] + new_body + content[m.end(2):]
    else:
        apps_idx = content.find('"apps"')
        if apps_idx != -1:
            brace_idx = content.find('{', apps_idx)
            if brace_idx != -1 and new_opts:
                insert_block = f'\n\t\t\t\t\t"{appid}"\n\t\t\t\t\t{{\n\t\t\t\t\t\t"LaunchOptions"\t\t"{new_opts}"\n\t\t\t\t\t}}'
                new_content = content[:brace_idx+1] + insert_block + content[brace_idx+1:]
            else:
                new_content = content
        else:
            new_content = content

    with open(lconf_path, "w", encoding="utf-8") as f:
        f.write(new_content)

    if new_opts:
        print(f"\n\033[1;32m✔ Updated LaunchOptions to:\033[0m {new_opts}")
    else:
        print(f"\n\033[1;32m✔ Cleared LaunchOptions for {name}.\033[0m")
    import time; time.sleep(1.2)

def set_proton_tool(appid):
    """Set per-game compatibility tool in config.vdf."""
    ensure_steam_stopped_for_vdf_edit()
    name = get_game_name(appid)
    cfg_path = os.path.join(STEAM_ROOT, "config", "config.vdf")
    if not os.path.isfile(cfg_path):
        print(f"\n\033[1;31mError: config.vdf not found at {cfg_path}\033[0m")
        return

    tools = get_available_proton_tools()
    current = get_compat_tool(appid)

    print("\n" + "=" * 65)
    print(f"  🍷  Select Proton / Compatibility Tool for \033[1;36m{name}\033[0m")
    print(f"  Current: \033[1;33m{current}\033[0m")
    print("=" * 65 + "\n")

    for idx, (tid, label) in enumerate(tools):
        marker = "▶" if tid == current or (not tid and "Default" in current) else " "
        print(f" {marker} \033[1;33m[{idx}]\033[0m {label} \033[2m({tid or 'default'})\033[0m")

    try:
        choice = input(f"\nSelect tool [0-{len(tools)-1}] (ENTER to cancel): ").strip()
    except (KeyboardInterrupt, EOFError):
        return

    if not choice.isdigit() or not (0 <= int(choice) < len(tools)):
        print("Cancelled.")
        import time; time.sleep(0.8)
        return

    chosen_id, chosen_label = tools[int(choice)]

    with open(cfg_path, "r", encoding="utf-8", errors="ignore") as f:
        content = f.read()

    cm_idx = content.find('"CompatToolMapping"')
    if cm_idx == -1:
        print("Error: CompatToolMapping section not found in config.vdf")
        return

    app_pat = r'(\"' + str(appid) + r'\"\s*\{[\s\n]*\"name\"\s+\")([^\"]*)(\")'
    if re.search(app_pat, content):
        if chosen_id:
            new_content = re.sub(app_pat, r'\g<1>' + chosen_id + r'\g<3>', content)
        else:
            remove_pat = r'\"' + str(appid) + r'\"\s*\{[^}]*\}\s*'
            new_content = re.sub(remove_pat, '', content)
    elif chosen_id:
        brace_idx = content.find('{', cm_idx)
        if brace_idx != -1:
            entry = f'\n\t\t\t\t\t"{appid}"\n\t\t\t\t\t{{\n\t\t\t\t\t\t"name"\t\t"{chosen_id}"\n\t\t\t\t\t\t"config"\t\t""\n\t\t\t\t\t\t"priority"\t\t"250"\n\t\t\t\t\t}}'
            new_content = content[:brace_idx+1] + entry + content[brace_idx+1:]
        else:
            new_content = content
    else:
        new_content = content

    with open(cfg_path, "w", encoding="utf-8") as f:
        f.write(new_content)

    print(f"\n\033[1;32m✔ Compatibility tool updated to:\033[0m {chosen_label}")
    import time; time.sleep(1.2)

def files_menu(appid):
    """Direct prefix, save-data, and game directory browser / launcher."""
    name = get_game_name(appid)
    installed = get_installed_games()
    app_meta = installed.get(str(appid))

    install_path = app_meta.get("install_path") if app_meta else None
    pfx_drive_c = None
    appdata_path = None
    pfx_dir = None

    for lib in get_library_folders():
        cpath = os.path.join(lib, "steamapps", "compatdata", str(appid), "pfx")
        if os.path.isdir(cpath):
            pfx_dir = cpath
            dc = os.path.join(cpath, "drive_c")
            if os.path.isdir(dc):
                pfx_drive_c = dc
                ad = os.path.join(dc, "users", "steamuser", "AppData")
                if os.path.isdir(ad):
                    appdata_path = ad
            break

    if not install_path and not pfx_drive_c:
        print(f"\n\033[1;33mNo local files or Proton prefix found for {name} (AppID: {appid}).\033[0m")
        try:
            input("\nPress ENTER to return...")
        except (KeyboardInterrupt, EOFError):
            pass
        return

    print("\n" + "=" * 65)
    print(f"  📁  Files & Runtime Tools for \033[1;36m{name}\033[0m (AppID: {appid})")
    print("=" * 65)
    if install_path and os.path.isdir(install_path):
        print(f"  Install Dir: \033[2m{install_path}\033[0m")
    if pfx_drive_c:
        print(f"  Prefix Dir:  \033[2m{pfx_drive_c}\033[0m")
    print("-" * 65)

    options = []
    if install_path and os.path.isdir(install_path):
        options.append(("term_game", "Open Game Directory in Terminal ($SHELL)"))
        options.append(("gui_game", "Open Game Directory in File Manager (xdg-open)"))
    if pfx_drive_c and os.path.isdir(pfx_drive_c):
        options.append(("term_pfx", "Open Proton Prefix (drive_c) in Terminal"))
    if appdata_path and os.path.isdir(appdata_path):
        options.append(("term_appdata", "Open AppData (Saves / Configs) in Terminal"))
    if pfx_dir:
        options.append(("winecfg", "Launch winecfg inside Game Prefix"))
        options.append(("term_wine", "Open Terminal with WINEPREFIX pre-configured"))

    for idx, (action, label) in enumerate(options):
        print(f"  \033[1;33m[{idx+1}]\033[0m {label}")
    print(f"  \033[1;37m[0]\033[0m Return to Library")

    try:
        choice = input(f"\nSelect action [0-{len(options)}]: ").strip()
    except (KeyboardInterrupt, EOFError):
        return

    if not choice.isdigit() or choice == "0":
        return

    c_idx = int(choice) - 1
    if not (0 <= c_idx < len(options)):
        return

    act = options[c_idx][0]
    shell = os.environ.get("SHELL", "/bin/bash")

    if act == "term_game":
        print(f"\nSpawning shell in {install_path} (type 'exit' to return)...")
        subprocess.run([shell], cwd=install_path)
    elif act == "gui_game":
        subprocess.run(["xdg-open", install_path], stderr=subprocess.DEVNULL)
    elif act == "term_pfx":
        print(f"\nSpawning shell in {pfx_drive_c} (type 'exit' to return)...")
        subprocess.run([shell], cwd=pfx_drive_c)
    elif act == "term_appdata":
        print(f"\nSpawning shell in {appdata_path} (type 'exit' to return)...")
        subprocess.run([shell], cwd=appdata_path)
    elif act == "winecfg":
        print(f"\nLaunching winecfg for {name} prefix...")
        env = dict(os.environ)
        env["WINEPREFIX"] = pfx_dir
        subprocess.run(["winecfg"], env=env, stderr=subprocess.DEVNULL)
    elif act == "term_wine":
        print(f"\nSpawning shell with WINEPREFIX={pfx_dir} (type 'exit' to return)...")
        env = dict(os.environ)
        env["WINEPREFIX"] = pfx_dir
        subprocess.run([shell], cwd=pfx_drive_c or pfx_dir, env=env)

def load_owned_cache():
    """Load cached owned games from ~/.cache/steam_tui/owned_cache.json."""
    if not os.path.isfile(CACHE_FILE):
        return {}
    try:
        with open(CACHE_FILE, "r", encoding="utf-8", errors="ignore") as f:
            data = json.load(f)
            if isinstance(data, dict):
                return data.get("apps", data)
    except Exception:
        pass
    return {}

def save_owned_cache(owned_games):
    """Save owned games to ~/.cache/steam_tui/owned_cache.json."""
    os.makedirs(CACHE_DIR, exist_ok=True)
    cache_payload = {
        "last_synced": int(datetime.now().timestamp()),
        "apps": owned_games,
    }
    tmp_file = CACHE_FILE + ".tmp"
    try:
        with open(tmp_file, "w", encoding="utf-8") as f:
            json.dump(cache_payload, f, indent=2, ensure_ascii=False)
        os.replace(tmp_file, CACHE_FILE)
    except Exception as e:
        if os.path.exists(tmp_file):
            try:
                os.remove(tmp_file)
            except Exception:
                pass
        sys.stderr.write(f"Error saving owned cache: {e}\n")

def fetch_store_app_name(appid):
    """Fallback query to Steam Store API for a single app name."""
    url = f"https://store.steampowered.com/api/appdetails?appids={appid}&filters=basic"
    req = urllib.request.Request(url, headers={"User-Agent": "steam-tui/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=3) as resp:
            data = json.loads(resp.read().decode("utf-8", errors="ignore"))
            entry = data.get(str(appid), {})
            if entry.get("success") and "data" in entry:
                app_data = entry["data"]
                return app_data.get("name"), app_data.get("type", "game")
    except Exception:
        pass
    return None, None

def sync_library():
    """Perform a full synchronization of owned and installed games."""
    config = load_config()
    existing_cache = load_owned_cache()
    owned_games = dict(existing_cache) if existing_cache else {}

    # 1. Check Steam Web API if credentials are provided in config.env
    api_key = config.get("STEAM_API_KEY")
    steam_id64 = config.get("STEAM_ID64")
    if api_key and steam_id64:
        try:
            url = (
                f"https://api.steampowered.com/IPlayerService/GetOwnedGames/v0001/"
                f"?key={api_key}&steamid={steam_id64}&include_appinfo=1&include_played_free_games=1&format=json"
            )
            req = urllib.request.Request(url, headers={"User-Agent": "steam-tui/1.0"})
            with urllib.request.urlopen(req, timeout=6) as resp:
                res = json.loads(resp.read().decode("utf-8", errors="ignore"))
                games_list = res.get("response", {}).get("games", [])
                for g in games_list:
                    aid = str(g.get("appid"))
                    nm = g.get("name", "")
                    if aid and nm and not is_filtered(nm):
                        owned_games[aid] = {"name": nm, "type": "game"}
        except Exception as e:
            sys.stderr.write(f"Web API sync failed, falling back to local scan: {e}\n")

    # 2. Local Discovery: Harvest AppIDs from localconfig.vdf, sharedconfig.vdf, appcache, and librarycache
    candidate_appids = set()

    for lconf in glob.glob(os.path.join(STEAM_ROOT, "userdata/*/config/localconfig.vdf")):
        try:
            with open(lconf, "r", encoding="utf-8", errors="ignore") as f:
                text = f.read()
            apps_idx = text.find('"apps"')
            if apps_idx != -1:
                apps_slice = text[apps_idx:]
                for m in re.finditer(r'\"(\d{2,10})\"\s*\{', apps_slice):
                    candidate_appids.add(m.group(1))
        except Exception:
            pass

    for sconf in glob.glob(os.path.join(STEAM_ROOT, "userdata/*/7/remote/sharedconfig.vdf")):
        try:
            with open(sconf, "r", encoding="utf-8", errors="ignore") as f:
                text = f.read()
            apps_idx = text.find('"apps"')
            if apps_idx != -1:
                apps_slice = text[apps_idx:]
                for m in re.finditer(r'\"(\d{2,10})\"\s*\{', apps_slice):
                    candidate_appids.add(m.group(1))
        except Exception:
            pass

    for d in glob.glob(os.path.join(STEAM_ROOT, "appcache/librarycache/*")):
        base = os.path.basename(d)
        if base.isdigit():
            candidate_appids.add(base)

    for j in glob.glob(os.path.join(STEAM_ROOT, "userdata/*/config/librarycache/*.json")):
        base = os.path.splitext(os.path.basename(j))[0]
        if base.isdigit():
            candidate_appids.add(base)

    # 3. Resolve names using local appinfo.vdf cache (instant, no network)
    appinfo_apps = parse_appinfo_vdf()
    for aid in candidate_appids:
        if aid in appinfo_apps:
            info = appinfo_apps[aid]
            if not is_filtered(info["name"], info.get("type", "game")):
                owned_games[aid] = info

    # 4. Include currently installed games from all libraries
    installed = get_installed_games()
    for aid, app in installed.items():
        if not is_filtered(app["name"]):
            owned_games[aid] = {"name": app["name"], "type": "game"}

    # 5. Clean up any filtered items from cache
    owned_games = {
        aid: info for aid, info in owned_games.items()
        if not is_filtered(info.get("name", ""), info.get("type", "game"))
    }

    save_owned_cache(owned_games)
    return owned_games

def list_games():
    """Output tab-delimited game list formatted for fzf."""
    installed = get_installed_games()
    owned = load_owned_cache()

    # If cache is empty, run an initial fast sync
    if not owned:
        owned = sync_library()

    output_lines = []

    # 1. Installed games
    installed_sorted = sorted(
        installed.values(),
        key=lambda x: x["name"].lower()
    )
    for app in installed_sorted:
        sf = app.get("state_flags", 4)
        if sf & 1024:
            display_label = f"\033[1;36m[UPDATING]\033[0m    {app['name']}"
            output_lines.append(f"{display_label}\t{app['appid']}\tUPDATING\t")
        elif sf & 2:
            display_label = f"\033[1;33m[UPDATE]\033[0m      {app['name']}"
            output_lines.append(f"{display_label}\t{app['appid']}\tUPDATE_REQUIRED\t")
        else:
            display_label = f"\033[1;32m[INSTALLED]\033[0m   {app['name']}"
            output_lines.append(f"{display_label}\t{app['appid']}\tINSTALLED\t")

    # 2. Non-Steam Shortcuts
    shortcuts = get_non_steam_shortcuts()
    shortcuts_sorted = sorted(
        shortcuts.values(),
        key=lambda x: x["name"].lower()
    )
    for sc in shortcuts_sorted:
        display_label = f"\033[1;35m[SHORTCUT]\033[0m    {sc['name']}"
        output_lines.append(f"{display_label}\t{sc['appid']}\tSHORTCUT\t{sc['shortcut_id']}")

    # 3. Available (Uninstalled Owned) games
    installed_ids = set(installed.keys())
    shortcut_ids = set(shortcuts.keys())
    available = []
    for aid, info in owned.items():
        if aid not in installed_ids and aid not in shortcut_ids:
            name = info.get("name", f"App {aid}")
            available.append({"appid": aid, "name": name})

    available_sorted = sorted(
        available,
        key=lambda x: x["name"].lower()
    )
    for app in available_sorted:
        display_label = f"\033[1;34m[AVAILABLE]\033[0m   {app['name']}"
        output_lines.append(f"{display_label}\t{app['appid']}\tAVAILABLE\t")

    return "\n".join(output_lines)

def format_size(bytes_num):
    """Format bytes into human-readable size."""
    if bytes_num <= 0:
        return "Unknown"
    for unit in ["B", "KB", "MB", "GB", "TB"]:
        if bytes_num < 1024.0:
            return f"{bytes_num:.2f} {unit}"
        bytes_num /= 1024.0
    return f"{bytes_num:.2f} PB"

def cleanup_stale_steam_locks():
    """Ensure dead steam.pid / steam.pipe FIFO locks don't hang Steam startups."""
    pid_file = os.path.expanduser("~/.steam/steam.pid")
    pipe_file = os.path.expanduser("~/.steam/steam.pipe")
    if os.path.isfile(pid_file):
        try:
            with open(pid_file, "r") as f:
                pid = int(f.read().strip())
            try:
                os.kill(pid, 0)
            except OSError:
                for fpath in [pid_file, pipe_file, os.path.expanduser("~/.local/share/Steam/steam.pid"), os.path.expanduser("~/.local/share/Steam/steam.pipe")]:
                    if os.path.exists(fpath):
                        try:
                            os.remove(fpath)
                        except Exception:
                            pass
        except Exception:
            pass
    elif os.path.exists(pipe_file):
        res = subprocess.run(["pgrep", "-x", "steam"], stdout=subprocess.DEVNULL)
        if res.returncode != 0:
            for fpath in [pipe_file, os.path.expanduser("~/.local/share/Steam/steam.pipe")]:
                if os.path.exists(fpath):
                    try:
                        os.remove(fpath)
                    except Exception:
                        pass

def is_steam_running_and_healthy():
    """Check if Steam daemon process is alive and steam.pipe FIFO exists."""
    res = subprocess.run(["pgrep", "-x", "steam"], stdout=subprocess.DEVNULL)
    if res.returncode != 0:
        return False
    pipe_file = os.path.expanduser("~/.steam/steam.pipe")
    alt_pipe = os.path.join(STEAM_ROOT, "steam.pipe")
    return os.path.exists(pipe_file) or os.path.exists(alt_pipe)

def wait_for_steam_ready(timeout=25):
    """Wait until steam.pipe exists and Steam IPC is accepting commands."""
    import time
    pipe_file = os.path.expanduser("~/.steam/steam.pipe")
    alt_pipe = os.path.join(STEAM_ROOT, "steam.pipe")
    conn_log = os.path.join(STEAM_ROOT, "logs", "connection_log.txt")
    start_t = time.time()
    pipe_detected = False
    pipe_time = 0

    while time.time() - start_t < timeout:
        res = subprocess.run(["pgrep", "-x", "steam"], stdout=subprocess.DEVNULL)
        if res.returncode != 0:
            time.sleep(0.5)
            continue

        if os.path.exists(pipe_file) or os.path.exists(alt_pipe):
            if not pipe_detected:
                pipe_detected = True
                pipe_time = time.time()

            # Check if connection_log shows "LoggedOn"
            if os.path.isfile(conn_log):
                try:
                    with open(conn_log, "rb") as f:
                        f.seek(max(0, os.path.getsize(conn_log) - 4096))
                        tail = f.read().decode("utf-8", errors="ignore")
                    if "LoggedOn" in tail or "LogOnResponse" in tail or "k_EMsgClientLogOnResponse" in tail:
                        time.sleep(1.0)
                        return True
                except Exception:
                    pass

            # If pipe has existed for at least 6 seconds, assume ready
            if time.time() - pipe_time >= 6.0:
                return True

        time.sleep(0.5)

    return is_steam_running_and_healthy()

def start_headless_daemon():
    """Start Steam silently without full GUI overhead and block until IPC pipe & login are ready."""
    cleanup_stale_steam_locks()
    res = subprocess.run(["pgrep", "-x", "steam"], stdout=subprocess.DEVNULL)
    if res.returncode != 0:
        print("\033[1;34mStarting minimal Steam daemon...\033[0m")
        # -silent keeps main window unmapped; -nofriendsui and -nochatui avoid loading chat/friends CEF modules.
        # -no-browser and -vgui are avoided because they break modern Steam's SharedJSContext app launch and update pipeline.
        cmd = [
            REAL_STEAM,
            "-silent",
            "-nofriendsui",
            "-nochatui",
            "-noverifyfiles",
            "-cef-disable-gpu",
            "-cef-disable-gpu-compositing",
            "-cef-in-process-gpu",
            "-cef-disable-hang-timeouts",
            "-cef-enable-debugging",
            "-js-flags=--max-old-space-size=64 --lite-mode --optimize-for-size",
        ]
        subprocess.Popen(cmd, env=get_steam_env(headless=True), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        sys.stdout.write("Waiting for Steam IPC & network connection...")
        sys.stdout.flush()
        ok = wait_for_steam_ready(timeout=25)
        if ok:
            print(" \033[1;32m[Ready]\033[0m")
        else:
            print(" \033[1;33m[Timeout waiting for LoggedOn, proceeding]\033[0m")
        constrain_headless_cef()

def select_library_folder():
    """Let user pick target drive if multiple Steam libraries exist."""
    libs = get_library_folders()
    if len(libs) <= 1:
        return 0, libs[0]

    print("\n\033[1;36mSelect target Steam Library drive:\033[0m")
    for idx, path in enumerate(libs):
        try:
            total, used, free = shutil.disk_usage(path)
            free_str = f"(\033[1;32m{format_size(free)} free\033[0m)"
        except Exception:
            free_str = ""
        print(f"  \033[1;33m[{idx}]\033[0m {path} {free_str}")

    choice = input(f"\nSelect library [0-{len(libs)-1}] (default 0): ").strip()
    idx = int(choice) if choice.isdigit() and 0 <= int(choice) < len(libs) else 0
    return idx, libs[idx]

def find_manifest_across_libraries(appid):
    """Find appmanifest_<appid>.acf across all drives (even if newly created)."""
    for lib_path in get_library_folders():
        candidate = os.path.join(lib_path, "steamapps", f"appmanifest_{appid}.acf")
        if os.path.isfile(candidate):
            return candidate
    return None

def show_preview(appid, status=None):
    """Display clean Kitty-formatted metadata and pixel-perfect thumbnail."""
    config = load_config()
    installed = get_installed_games()
    shortcuts = get_non_steam_shortcuts()
    is_installed = str(appid) in installed
    is_shortcut = str(appid) in shortcuts or status == "SHORTCUT"
    sc = shortcuts.get(str(appid))

    if is_shortcut:
        title = sc["name"] if sc else get_game_name(appid)
    elif is_installed:
        app_meta = installed[str(appid)]
        title = app_meta["name"]
    else:
        owned = load_owned_cache()
        if str(appid) in owned:
            title = owned[str(appid)].get("name", f"App {appid}")
        else:
            title = f"Steam App {appid}"

    # Artwork resolution & caching
    chosen_img = None
    if config.get("ENABLE_IMAGE_PREVIEW", "1") == "1":
        # 1. Local librarycache glob (handles newer client hash subdirectories)
        libcache_matches = glob.glob(
            os.path.join(STEAM_ROOT, "appcache", "librarycache", str(appid), "**", "*header*.jpg"),
            recursive=True
        )
        if not libcache_matches:
            libcache_matches = glob.glob(
                os.path.join(STEAM_ROOT, "appcache", "librarycache", str(appid), "**", "*library_600x900*.jpg"),
                recursive=True
            )

        # 2. Local custom grid art (shortcuts)
        grid_matches = []
        if is_shortcut and sc:
            sc_id = sc.get("shortcut_id")
            grid_matches = glob.glob(os.path.join(STEAM_ROOT, "userdata/*/grid", f"{appid}*"))
            if not grid_matches and sc_id:
                grid_matches = glob.glob(os.path.join(STEAM_ROOT, "userdata/*/grid", f"{sc_id}*"))

        # 3. Persistent cache directory
        art_cache_dir = os.path.join(CACHE_DIR, "art")
        cached_art_path = os.path.join(art_cache_dir, f"{appid}.jpg")

        if libcache_matches:
            chosen_img = libcache_matches[0]
        elif grid_matches:
            chosen_img = grid_matches[0]
        elif os.path.isfile(cached_art_path):
            chosen_img = cached_art_path
        elif not is_shortcut:
            # 4. Fetch missing header art once from Steam CDN
            try:
                os.makedirs(art_cache_dir, exist_ok=True)
                cdn_url = f"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/{appid}/header.jpg"
                req = urllib.request.Request(cdn_url, headers={"User-Agent": "steam-tui/1.0"})
                with urllib.request.urlopen(req, timeout=1.8) as resp:
                    if resp.status == 200:
                        with open(cached_art_path, "wb") as f_art:
                            f_art.write(resp.read())
                        chosen_img = cached_art_path
            except Exception:
                pass

        # Clear previous Kitty graphic in preview pane
        sys.stdout.write("\033_Ga=d,d=A\033\\")
        sys.stdout.flush()

        if chosen_img and os.path.isfile(chosen_img):
            cols = os.environ.get("FZF_PREVIEW_COLUMNS", "44")
            size_arg = config.get("CHAFA_SIZE", f"{cols}x12")
            if shutil.which("chafa"):
                subprocess.run(
                    ["chafa", "-f", "kitty", "--passthrough=none", "--size", size_arg, chosen_img],
                    check=False
                )
                print()
            elif shutil.which("kitten"):
                subprocess.run([
                    "kitten", "icat",
                    "--clear",
                    "--transfer-mode=memory",
                    "--unicode-placeholder",
                    "--stdin=no",
                    f"--place={cols}x12@0x0",
                    chosen_img
                ], check=False)
                print("\n" * 12)

    # Metadata Card
    print(f"\033[1;36m╭──────────────────────────────────────────────────╮\033[0m")
    print(f"\033[1;36m│\033[0m \033[1mTitle:\033[0m    \033[1;37m{title[:37]}\033[0m")
    print(f"\033[1;36m│\033[0m \033[1mAppID:\033[0m    \033[1;33m{appid}\033[0m")

    compat = get_compat_tool(appid)
    print(f"\033[1;36m│\033[0m \033[1mRuntime:\033[0m  \033[1;35m{compat[:37]}\033[0m")

    if is_shortcut:
        print(f"\033[1;36m│\033[0m \033[1mStatus:\033[0m   \033[1;35m● Non-Steam Shortcut\033[0m")
        if sc and sc.get("exe"):
            print(f"\033[1;36m│\033[0m \033[1mBinary:\033[0m   \033[2m{sc['exe'][:37]}\033[0m")
        if sc and sc.get("shortcut_id"):
            print(f"\033[1;36m│\033[0m \033[1mID64:\033[0m     \033[2m{sc['shortcut_id']}\033[0m")
        print(f"\033[1;36m├──────────────────────────────────────────────────┤\033[0m")
        print(f"\033[1;36m│\033[0m \033[1;32mAction: Press <ENTER> to launch shortcut\033[0m")
    elif is_installed:
        app_meta = installed[str(appid)]
        sf = app_meta.get("state_flags", 4)
        if sf & 1024:
            b_dl = app_meta.get("bytes_downloaded", 0)
            b_to = app_meta.get("bytes_to_download", 0)
            status_line = f"\033[1;36m◐ Updating in background ({format_size(b_dl)} / {format_size(b_to)})\033[0m"
        elif sf & 2:
            b_to = app_meta.get("bytes_to_download", 0)
            status_line = f"\033[1;33m▲ Update Required ({format_size(b_to)} pending)\033[0m"
        else:
            status_line = f"\033[1;32m● Installed (Ready to play)\033[0m"
        print(f"\033[1;36m│\033[0m \033[1mStatus:\033[0m   {status_line}")

        if app_meta.get("size"):
            print(f"\033[1;36m│\033[0m \033[1mSize:\033[0m     {format_size(app_meta['size'])}")
        if app_meta.get("last_played"):
            dt = datetime.fromtimestamp(app_meta["last_played"])
            print(f"\033[1;36m│\033[0m \033[1mPlayed:\033[0m   {dt.strftime('%Y-%m-%d %H:%M')}")

        cloud = get_cloud_save_status(appid)
        print(f"\033[1;36m│\033[0m \033[1mCloud:\033[0m    \033[2m{cloud[:37]}\033[0m")

        if app_meta.get("library"):
            print(f"\033[1;36m│\033[0m \033[1mDrive:\033[0m    {app_meta['library']}")
        print(f"\033[1;36m├──────────────────────────────────────────────────┤\033[0m")
        if sf & (2 | 1024):
            print(f"\033[1;36m│\033[0m \033[1;33mAction: Press <ENTER> to track update in terminal\033[0m")
        else:
            print(f"\033[1;36m│\033[0m \033[1;32mAction: Press <ENTER> to launch game\033[0m")
        print(f"\033[1;36m│\033[0m \033[1;31mAction: Press <Ctrl-X> to uninstall game\033[0m")
    else:
        print(f"\033[1;36m│\033[0m \033[1mStatus:\033[0m   \033[1;34m○ Uninstalled (Available in library)\033[0m")
        cloud = get_cloud_save_status(appid)
        print(f"\033[1;36m│\033[0m \033[1mCloud:\033[0m    \033[2m{cloud[:37]}\033[0m")
        print(f"\033[1;36m├──────────────────────────────────────────────────┤\033[0m")
        print(f"\033[1;36m│\033[0m \033[1;36mAction: Press <ENTER> to install in terminal\033[0m")

    print(f"\033[1;36m│\033[0m \033[2mHotkeys: <Ctrl-O> Launch Opts │ <Ctrl-P> Proton │ <Ctrl-F> Files\033[0m")
    print(f"\033[1;36m╰──────────────────────────────────────────────────╯\033[0m")

def launch_app(appid, shortcut_id=None):
    """Launch an installed application or non-Steam shortcut silently."""
    start_headless_daemon()
    if shortcut_id:
        cmd = [REAL_STEAM, "-silent", f"steam://rungameid/{shortcut_id}"]
    else:
        cmd = [REAL_STEAM, "-silent", "-applaunch", str(appid)]
    subprocess.Popen(
        cmd,
        env=get_steam_env(headless=True),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True
    )

def track_update(appid, is_new_install=False):
    """Headless install & update tracker with EULA bypass and live progress bar."""
    import time
    owned = load_owned_cache()
    installed = get_installed_games()
    name = installed.get(str(appid), {}).get("name") or owned.get(str(appid), {}).get("name", f"App {appid}")

    # 1. Ensure minimal Steam daemon is running in background and ready
    start_headless_daemon()

    # 2. Trigger headless install/update via bootstrap ACF or steam://install
    if is_new_install:
        lib_idx, lib_path = select_library_folder()
        print(f"\n\033[1;36mDispatching headless install for {name} to {lib_path}...\033[0m")
        
        # Write bootstrap appmanifest_<appid>.acf with StateFlags "2" (Update Required)
        # This tells Steam the target library and bypasses drive selection/EULA modals
        target_steamapps = os.path.join(lib_path, "steamapps")
        os.makedirs(target_steamapps, exist_ok=True)
        manifest_file = os.path.join(target_steamapps, f"appmanifest_{appid}.acf")
        if not os.path.exists(manifest_file):
            try:
                bootstrap_content = (
                    '"AppState"\n'
                    '{\n'
                    f'\t"appid"\t\t"{appid}"\n'
                    '\t"Universe"\t\t"1"\n'
                    f'\t"name"\t\t"{name}"\n'
                    '\t"StateFlags"\t\t"2"\n'
                    '\t"installdir"\t\t""\n'
                    '\t"LastUpdated"\t\t"0"\n'
                    '\t"SizeOnDisk"\t\t"0"\n'
                    '}\n'
                )
                with open(manifest_file, "w", encoding="utf-8") as f:
                    f.write(bootstrap_content)
            except Exception:
                pass

        # Trigger download in Steam via steam://install/<appid> and -applaunch
        subprocess.Popen([REAL_STEAM, "-silent", f"steam://install/{appid}"], env=get_steam_env(headless=True), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        time.sleep(1)
        subprocess.Popen([REAL_STEAM, "-silent", "-applaunch", str(appid)], env=get_steam_env(headless=True), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    else:
        print(f"\n\033[1;36mDispatching headless update for {name}...\033[0m")
        subprocess.Popen([REAL_STEAM, "-silent", f"steam://install/{appid}"], env=get_steam_env(headless=True), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        time.sleep(1)
        subprocess.Popen([REAL_STEAM, "-silent", "-applaunch", str(appid)], env=get_steam_env(headless=True), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

    # 3. Wait up to 15 seconds for Steam to allocate/recognize appmanifest_<appid>.acf
    manifest_path = find_manifest_across_libraries(appid)
    if not manifest_path:
        sys.stdout.write("\033[1;33mAllocating disk space & generating manifest...\033[0m")
        sys.stdout.flush()
        for _ in range(30):
            time.sleep(0.5)
            manifest_path = find_manifest_across_libraries(appid)
            if manifest_path:
                break
        if not manifest_path:
            # Fallback trigger
            subprocess.Popen([REAL_STEAM, "-silent", "-applaunch", str(appid)], env=get_steam_env(headless=True), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            for _ in range(20):
                time.sleep(0.5)
                manifest_path = find_manifest_across_libraries(appid)
                if manifest_path:
                    break

    if not manifest_path:
        sys.stderr.write(f"\n\033[1;31mError: Steam did not create a manifest for {appid}. Is the account logged in?\033[0m\n")
        return

    print(f"\r\033[K\033[2m[Ctrl+C] to detach (download continues in background)\033[0m\n")

    content_log = os.path.join(STEAM_ROOT, "logs", "content_log.txt")
    last_bytes = 0
    last_time = time.time()
    speed_mb_s = 0.0
    has_started = False
    init_check_time = time.time()

    try:
        while True:
            acf = parse_acf_file(manifest_path)
            if not acf:
                time.sleep(0.5)
                continue

            sf = acf["state_flags"]
            dl = acf["bytes_downloaded"]
            to_dl = acf["bytes_to_download"]
            st = acf["bytes_staged"]
            to_st = acf["bytes_to_stage"]

            # Mark if download or update activity is detected
            if (sf & 1024) or (to_dl > 0 and dl > 0) or (to_st > 0):
                has_started = True

            # StateFlags == 4 means Fully Installed and Ready
            if sf == 4 and (to_dl == 0 or dl >= to_dl):
                if has_started:
                    print(f"\r\033[K\033[1;32m✔ Installation/Update complete for {name}!\033[0m\n")
                    subprocess.run(["notify-send", "Steam (Headless)", f"{name} is ready!", "-i", "steam"], check=False)
                    return
                elif time.time() - init_check_time > 3.0:
                    print(f"\r\033[K\033[1;32m✔ {name} is already up to date and ready to play!\033[0m\n")
                    return

            # Parse real-time download rate from content_log.txt if available
            if os.path.isfile(content_log):
                try:
                    with open(content_log, "rb") as f:
                        f.seek(0, os.SEEK_END)
                        f.seek(max(0, f.tell() - 4096), os.SEEK_SET)
                        tail = f.read().decode("utf-8", errors="ignore")
                    rate_matches = re.findall(r"Current download rate:\s+([\d\.]+)\s+Mbps", tail)
                    if rate_matches:
                        # Convert Mbps to MB/s
                        speed_mb_s = float(rate_matches[-1]) / 8.0
                except Exception:
                    pass

            # Fallback rate calculation from manifest delta
            now = time.time()
            dt = now - last_time
            if dt >= 1.5 and speed_mb_s == 0.0:
                delta_bytes = max(0, dl - last_bytes)
                speed_mb_s = (delta_bytes / (1024 * 1024)) / dt
                last_bytes = dl
                last_time = now

            if to_dl > 0:
                pct = min(100.0, (dl / to_dl) * 100.0)
            elif to_st > 0:
                pct = min(100.0, (st / to_st) * 100.0)
            else:
                pct = 0.0

            bar_len = 28
            filled = int(bar_len * pct / 100.0)
            bar = "█" * filled + "░" * (bar_len - filled)

            eta_str = ""
            if speed_mb_s > 0.05 and to_dl > dl:
                rem_sec = int((to_dl - dl) / (speed_mb_s * 1024 * 1024))
                mins, secs = divmod(rem_sec, 60)
                eta_str = f"| ETA: {mins}m {secs:02d}s"

            if sf & 1024:
                status_txt = "\033[1;36mDownloading\033[0m"
            elif st > 0 and st < to_st:
                status_txt = "\033[1;35mUnpacking/Staging\033[0m"
            elif sf & 512:
                status_txt = "\033[1;33mPaused\033[0m"
            else:
                status_txt = "\033[1;34mPre-allocating\033[0m"

            progress_line = (
                f"\r\033[K\033[1;36m[{bar}]\033[0m {pct:5.1f}% │ "
                f"{format_size(dl)} / {format_size(to_dl)} │ "
                f"{speed_mb_s:5.1f} MB/s {eta_str} │ {status_txt}"
            )
            sys.stdout.write(progress_line)
            sys.stdout.flush()
            time.sleep(0.5)

    except KeyboardInterrupt:
        print("\n\n\033[1;33mDetached from progress view. Download continues in background.\033[0m")

def uninstall_app(appid):
    """Trigger uninstallation for an installed Steam app."""
    installed = get_installed_games()
    app = installed.get(str(appid))
    if not app:
        print(f"\n\033[1;33mAppID {appid} is not currently installed.\033[0m")
        return

    name = app.get("name", f"App {appid}")
    confirm = input(f"\n\033[1;31mAre you sure you want to uninstall {name} (AppID: {appid})? [y/N]: \033[0m").strip().lower()
    if confirm == 'y':
        print(f"\033[1;33mDispatching uninstallation for {name}...\033[0m")
        start_headless_daemon()
        subprocess.run([REAL_STEAM, "+app_uninstall", str(appid)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["notify-send", "Steam (Headless)", f"Uninstalled {name}", "-i", "steam"], check=False)
        import time
        time.sleep(1.5)
    else:
        print("Uninstallation cancelled.")

def get_running_steam_game():
    """Detect any actively running Steam game on Hyprland / system."""
    try:
        out = subprocess.check_output(['hyprctl', '-j', 'clients'], stderr=subprocess.DEVNULL).decode('utf-8')
        clients = json.loads(out)
        installed = get_installed_games()
        shortcuts = get_non_steam_shortcuts()

        for c in clients:
            cls = c.get('class', '')
            init_cls = c.get('initialClass', '')
            aid = None
            name = None

            if cls.startswith('steam_app_'):
                aid = cls.replace('steam_app_', '')
            elif init_cls.startswith('steam_app_'):
                aid = init_cls.replace('steam_app_', '')

            if aid:
                pid = c.get('pid')
                title = c.get('title', '')
                name = installed.get(aid, {}).get('name') or shortcuts.get(aid, {}).get('name') or title

                # Collect PID tree (process + direct children + AppId processes)
                pids_to_check = {str(pid)}
                try:
                    c_pids = subprocess.check_output(['pgrep', '-P', str(pid)], stderr=subprocess.DEVNULL).decode('utf-8').strip().split()
                    pids_to_check.update(c_pids)
                except Exception:
                    pass
                try:
                    aid_pids = subprocess.check_output(['pgrep', '-f', f'AppId={aid}'], stderr=subprocess.DEVNULL).decode('utf-8').strip().split()
                    pids_to_check.update(aid_pids)
                except Exception:
                    pass

                # Fetch process stats
                cpu, mem, etime = '0.0', '0.0', '00:00'
                try:
                    ps_out = subprocess.check_output(['ps', '-p', str(pid), '-o', '%cpu,%mem,etime'], stderr=subprocess.DEVNULL).decode('utf-8').strip().split('\n')
                    if len(ps_out) > 1:
                        parts = ps_out[1].split()
                        cpu, mem, etime = parts[0], parts[1], parts[2]
                except Exception:
                    pass

                # Parse standard nvidia-smi table for G, C, and C+G contexts across all matching PIDs
                vram = "N/A"
                try:
                    smi_out = subprocess.check_output(['nvidia-smi'], stderr=subprocess.DEVNULL).decode('utf-8')
                    total_vram_mib = 0
                    found_vram = False
                    for line in smi_out.split('\n'):
                        m = re.search(r'\|\s+\d+\s+(?:N/A|\d+)\s+(?:N/A|\d+)\s+(\d+)\s+([A-Z\+]+)\s+.*?\s+(\d+)MiB', line)
                        if m:
                            p_id, _, mem_val = m.group(1), m.group(2), int(m.group(3))
                            if p_id in pids_to_check:
                                total_vram_mib += mem_val
                                found_vram = True
                    if found_vram:
                        if total_vram_mib >= 1024:
                            vram = f"{total_vram_mib / 1024:.1f} GB"
                        else:
                            vram = f"{total_vram_mib} MB"
                except Exception:
                    pass

                return {
                    'appid': aid,
                    'name': name,
                    'title': title,
                    'pid': pid,
                    'workspace': c.get('workspace', {}).get('name', 'N/A'),
                    'cpu': cpu,
                    'mem': mem,
                    'etime': etime,
                    'vram': vram,
                }
    except Exception:
        pass

    # Fallback: check process table if window has not mapped yet (e.g. Proton prefix setup)
    try:
        reaper_out = subprocess.check_output(['pgrep', '-a', '-f', 'reaper SteamLaunch AppId='], stderr=subprocess.DEVNULL).decode('utf-8')
        installed = get_installed_games()
        shortcuts = get_non_steam_shortcuts()
        for line in reaper_out.strip().split('\n'):
            m = re.search(r'(\d+)\s+.*reaper SteamLaunch AppId=(\d+)', line)
            if m:
                r_pid, r_aid = int(m.group(1)), m.group(2)
                name = installed.get(r_aid, {}).get('name') or shortcuts.get(r_aid, {}).get('name') or f"App {r_aid}"
                return {
                    'appid': r_aid,
                    'name': name,
                    'title': name,
                    'pid': r_pid,
                    'workspace': 'Starting...',
                    'cpu': '0.0',
                    'mem': '0.0',
                    'etime': '00:00',
                    'vram': 'N/A',
                }
    except Exception:
        pass

    return None

def safe_post_game_shutdown(appid=None):
    """Wait for Proton prefix teardown and Cloud Sync completion before shutting down Steam."""
    import time
    sys.stdout.write("\033[1;34mWaiting for Proton prefix & Steam Cloud sync to finish...\033[0m")
    sys.stdout.flush()

    # 1. Wait until the SteamLaunch reaper container for this AppID has fully exited
    if appid:
        for _ in range(60):  # Up to 30s for slow wineserver teardown
            res = subprocess.run(["pgrep", "-f", f"AppId={appid}"], stdout=subprocess.DEVNULL)
            if res.returncode != 0:
                break
            time.sleep(0.5)

    # 2. Wait for Steam Cloud activity in cloud_log.txt to settle
    cloud_log = os.path.join(STEAM_ROOT, "logs", "cloud_log.txt")
    time.sleep(2.0)  # Initial window for Cloud Sync job to register after reaper exit
    if os.path.isfile(cloud_log):
        for _ in range(30):
            # If cloud_log.txt was modified in the last 2.5 seconds, sync is still active
            try:
                if time.time() - os.path.getmtime(cloud_log) < 2.5:
                    time.sleep(1.0)
                else:
                    break
            except Exception:
                break

    # 3. Ensure no background game updates/downloads are actively running before shutting down
    # Note: StateFlags 1024 is downloading, 512 is paused. An update is only actively downloading if 1024 is set and 512 is NOT set.
    installed = get_installed_games()
    is_actively_downloading = False
    for app in installed.values():
        sf = app.get("state_flags", 4)
        if (sf & 1024) and not (sf & 512):
            is_actively_downloading = True
            break

    if is_actively_downloading:
        print("\r\033[K\033[1;33mBackground download active; keeping headless Steam daemon alive.\033[0m")
        return

    print("\r\033[K\033[1;32m✔ Cloud saves synced. Shutting down Steam daemon (0 MB idle)...\033[0m")
    subprocess.run([REAL_STEAM, "-shutdown"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(10):
        time.sleep(0.5)
        if subprocess.run(["pgrep", "-x", "steam"], stdout=subprocess.DEVNULL).returncode != 0:
            break
    else:
        subprocess.run(["pkill", "-9", "-f", "ubuntu12_32/steam|steamwebhelper"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    cleanup_stale_steam_locks()

def auto_shutdown_watcher(appid=None):
    """Detached background worker that monitors a running game and invokes safe_post_game_shutdown when done."""
    import time
    while True:
        game = get_running_steam_game()
        if game and (str(game.get('appid')) == str(appid) or (appid and str(appid) in str(game.get('title', '')))):
            time.sleep(1.0)
            continue
        if appid:
            reaper = subprocess.run(["pgrep", "-f", f"AppId={appid}"], stdout=subprocess.DEVNULL)
            if reaper.returncode == 0:
                time.sleep(1.0)
                continue
        # Game has exited
        break
    safe_post_game_shutdown(appid)

def show_dashboard(target_appid=None):
    """Persistent dashboard for actively running Steam game session."""
    import select
    import termios
    import tty

    game = get_running_steam_game()
    if not game:
        print("No active Steam game is currently running.")
        return 1

    if not target_appid:
        target_appid = game.get('appid')

    old_settings = None
    if sys.stdin.isatty():
        old_settings = termios.tcgetattr(sys.stdin)

    try:
        if old_settings:
            tty.setcbreak(sys.stdin.fileno())

        while True:
            game = get_running_steam_game()
            if not game:
                sys.stdout.write("\r\033[K\n\033[1;32m✔ Active game session has finished.\033[0m\n\n")
                sys.stdout.flush()
                safe_post_game_shutdown(target_appid)
                return 0

            pss_mb = get_steam_pss_mb()
            daemon_info = f"Headless Mode (Steam PSS: {pss_mb} MB | Auto-Reclaim Active)"
            pad_daemon = max(0, 59 - len(daemon_info))

            lines = [
                "\033[H\033[J",
                "\033[1;36m╭──────────────────────────────────────────────────────────────────────────╮\033[0m",
                "\033[1;36m│\033[0m  \033[1;35m🎮 STEAM HEADLESS CLI\033[0m \033[2m│\033[0m \033[1;32m● Active Game Session\033[0m                           \033[1;36m│\033[0m",
                "\033[1;36m├──────────────────────────────────────────────────────────────────────────┤\033[0m",
                f"\033[1;36m│\033[0m  \033[1mGame:\033[0m        \033[1;37m{game['name'][:42]:<42}\033[0m \033[2m(AppID: {game['appid']:<8})\033[0m \033[1;36m│\033[0m",
                f"\033[1;36m│\033[0m  \033[1mProcess:\033[0m     PID \033[1;33m{str(game['pid']):<8}\033[0m \033[2m│\033[0m Workspace: \033[1;34m{str(game['workspace']):<32}\033[0m \033[1;36m│\033[0m",
                f"\033[1;36m│\033[0m  \033[1mTelemetry:\033[0m   Time: \033[1;32m{game['etime']:<7}\033[0m \033[2m│\033[0m CPU: \033[1;33m{game['cpu']:>4}%\033[0m \033[2m│\033[0m RAM: \033[1;33m{game['mem']:>4}%\033[0m \033[2m│\033[0m VRAM: \033[1;33m{game['vram']:<8}\033[0m \033[1;36m│\033[0m",
                f"\033[1;36m│\033[0m  \033[1mDaemon:\033[0m      \033[1;32mHeadless Mode\033[0m \033[2m(Steam PSS: {pss_mb} MB | Auto-Reclaim Active)\033[0m{' ' * pad_daemon}\033[1;36m│\033[0m",
                "\033[1;36m├──────────────────────────────────────────────────────────────────────────┤\033[0m",
                "\033[1;36m│\033[0m  \033[1;33m[b]\033[0m Browse Library     \033[1;31m[k]\033[0m Terminate Game     \033[1;37m[q / Esc]\033[0m Detach & Exit   \033[1;36m│\033[0m",
                "\033[1;36m╰──────────────────────────────────────────────────────────────────────────╯\033[0m",
            ]
            sys.stdout.write("\n".join(lines) + "\n")
            sys.stdout.flush()

            if sys.stdin.isatty():
                r, _, _ = select.select([sys.stdin], [], [], 1.0)
                if r:
                    key = sys.stdin.read(1)
                    if key in ('q', '\x1b'):
                        if target_appid:
                            backend_bin = os.path.abspath(__file__)
                            subprocess.Popen(
                                [sys.executable, backend_bin, "--auto-shutdown", str(target_appid)],
                                stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL,
                                start_new_session=True
                            )
                        return 0
                    elif key == 'b':
                        return 2
                    elif key == 'k':
                        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_settings)
                        sys.stdout.write(f"\n\033[1;31mTerminate {game['name']} (PID: {game['pid']})? [y/N]: \033[0m")
                        sys.stdout.flush()
                        ans = sys.stdin.readline().strip().lower()
                        if ans == 'y':
                            pid = int(game['pid'])
                            aid = game.get('appid') or target_appid
                            try:
                                # Terminate entire process group to avoid zombie wineserver/helpers
                                try:
                                    pgid = os.getpgid(pid)
                                    os.killpg(pgid, signal.SIGTERM)
                                except Exception:
                                    os.kill(pid, signal.SIGTERM)

                                # Signal SteamLaunch reaper and Proton wineservers
                                if aid:
                                    subprocess.run(["pkill", "-TERM", "-f", f"AppId={aid}"], stderr=subprocess.DEVNULL)
                                    subprocess.run(["pkill", "-TERM", "-f", f"steam_app_{aid}"], stderr=subprocess.DEVNULL)

                                sys.stdout.write(f"\033[1;32mSignal sent to terminate {game['name']} and child runtimes.\033[0m\n")
                                sys.stdout.flush()
                                safe_post_game_shutdown(aid)
                            except Exception as e:
                                sys.stdout.write(f"\033[1;31mError killing process: {e}\033[0m\n")
                            return 0
                        tty.setcbreak(sys.stdin.fileno())
            else:
                time.sleep(1.0)
    finally:
        if old_settings:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_settings)

def constrain_headless_cef():
    """Surgical CEF memory reducer for headless mode:
    1. Dedicated cgroup sub-slice for steamwebhelper PIDs only (MemoryHigh=128M, no MemoryMax).
    2. Moves all steamwebhelper PIDs (master root, zygotes, utilities) into steam-cef.slice.
    3. Immediately recycles bloated non-SharedJSContext child renderers via CDP (127.0.0.1:8080/json).
    4. Finds any --type=utility processes and triggers kernel memory.reclaim twice with 0.5s delay.
    """
    import urllib.request
    import json
    import time

    uid = os.getuid()
    cgroup_dir = f"/sys/fs/cgroup/user.slice/user-{uid}.slice/user@{uid}.service/app.slice/steam-cef.slice"
    try:
        os.makedirs(cgroup_dir, exist_ok=True)
    except Exception:
        pass

    # 1. Set MemoryHigh=128M. NEVER set MemoryMax so OOM killer never triggers!
    mem_high_file = os.path.join(cgroup_dir, "memory.high")
    if os.path.isfile(mem_high_file):
        try:
            with open(mem_high_file, "w") as f:
                f.write("134217728\n")
        except Exception:
            pass

    swap_max_file = os.path.join(cgroup_dir, "memory.swap.max")
    if os.path.isfile(swap_max_file):
        try:
            with open(swap_max_file, "w") as f:
                f.write("max\n")
        except Exception:
            pass

    # 2. Move all steamwebhelper PIDs (including master root and zygotes) into steam-cef.slice
    procs_file = os.path.join(cgroup_dir, "cgroup.procs")
    if os.path.isfile(procs_file):
        try:
            res = subprocess.run(["pgrep", "steamwebhelper"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            cef_pids = res.stdout.decode("utf-8").strip().split()
            for pid in cef_pids:
                try:
                    with open(procs_file, "w") as f:
                        f.write(f"{pid}\n")
                except Exception:
                    pass
        except Exception:
            pass

    # 3. Immediately recycle bloated non-SharedJSContext child renderers via CDP
    try:
        req = urllib.request.Request("http://127.0.0.1:8080/json", headers={"User-Agent": "steam-tui"})
        with urllib.request.urlopen(req, timeout=1.0) as resp:
            targets = json.loads(resp.read().decode("utf-8"))
            for t in targets:
                title = t.get("title", "")
                url = t.get("url", "")
                tid = t.get("id")
                # Do NOT touch SharedJSContext (required for Steamworks DRM, Steam Input, Cloud Sync)
                if "SharedJSContext" in title or "SharedJSContext" in url:
                    continue
                if tid:
                    try:
                        close_req = urllib.request.Request(f"http://127.0.0.1:8080/json/close/{tid}")
                        urllib.request.urlopen(close_req, timeout=0.5)
                    except Exception:
                        pass
    except Exception:
        pass

    # 4. Find any steamwebhelper child process with --type=utility and ensure it is moved
    if os.path.isfile(procs_file):
        try:
            for pid_dir in glob.glob("/proc/[0-9]*"):
                pid = os.path.basename(pid_dir)
                try:
                    with open(f"{pid_dir}/cmdline", "rb") as f_cmd:
                        cmdline = f_cmd.read().decode("utf-8", errors="ignore")
                        if "--type=utility" in cmdline and ("steamwebhelper" in cmdline or "exe" in cmdline):
                            with open(procs_file, "w") as f:
                                f.write(f"{pid}\n")
                except Exception:
                    pass
        except Exception:
            pass

    # Write 524288000 to memory.reclaim twice with 0.5s delay
    mem_reclaim_file = os.path.join(cgroup_dir, "memory.reclaim")
    if os.path.isfile(mem_reclaim_file):
        for _ in range(2):
            try:
                with open(mem_reclaim_file, "w") as f:
                    f.write("524288000\n")
            except OSError:
                pass
            time.sleep(0.5)

def launch_and_monitor(appid, shortcut_id=None):
    """Launch game silently, track update/shaders if needed, and monitor session persistently."""
    import time
    cleanup_stale_steam_locks()

    is_shortcut = bool(shortcut_id)
    if not is_shortcut:
        shortcuts = get_non_steam_shortcuts()
        if str(appid) in shortcuts:
            is_shortcut = True
            shortcut_id = shortcuts[str(appid)]["shortcut_id"]

    name = get_game_name(appid)

    if is_shortcut:
        start_headless_daemon()
        print(f"\n\033[1;36mInitializing Non-Steam Shortcut {name} (ID: {shortcut_id})...\033[0m")
        subprocess.Popen([REAL_STEAM, "-silent", f"steam://rungameid/{shortcut_id}"], env=get_steam_env(headless=True), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        subprocess.run(["notify-send", "Steam (Headless)", f"Launching {name}...", "-i", "steam"], check=False)
    else:
        installed = get_installed_games()
        app = installed.get(str(appid))
        manifest_path = app["manifest_path"] if app else None

        # 1. Update check
        if manifest_path and os.path.isfile(manifest_path):
            acf = parse_acf_file(manifest_path)
            if acf and (acf["state_flags"] & 2 or acf["state_flags"] & 1024):
                print(f"\n\033[1;33mGame update required for {name} ({format_size(acf['bytes_to_download'])})\033[0m")
                track_update(appid, is_new_install=False)

        # 2. Ensure minimal Steam daemon is running (CEF disabled)
        start_headless_daemon()

        # 3. Trigger silent launch
        print(f"\n\033[1;36mInitializing {name} (AppID: {appid})...\033[0m")
        subprocess.Popen([REAL_STEAM, "-silent", "-applaunch", str(appid)], env=get_steam_env(headless=True), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        subprocess.run(["notify-send", "Steam (Headless)", f"Launching {name}...", "-i", "steam"], check=False)

    # 4. Wait for game runtime to attach (dynamic timeout waiting for Proton/fossilize)
    sys.stdout.write("Waiting for game runtime to attach...")
    sys.stdout.flush()

    start_wait = time.time()
    while time.time() - start_wait < 120:
        time.sleep(0.5)
        foz = subprocess.run(["pgrep", "-f", "fossilize_replay"], stdout=subprocess.DEVNULL)
        if foz.returncode == 0:
            sys.stdout.write("\r\033[K\033[1;33m[Vulkan Shaders] Fossilize compiling pipelines in background...\033[0m")
            sys.stdout.flush()

        game = get_running_steam_game()
        if game:
            if game['appid'] == str(appid) or str(appid) in game.get('title', '') or (is_shortcut and (name.lower() in game.get('name', '').lower() or name.lower() in game.get('title', '').lower())):
                break

        # Check if steam launch helper or wine is still running
        reaper = subprocess.run(["pgrep", "-f", f"AppId={appid}"], stdout=subprocess.DEVNULL)
        wine_init = subprocess.run(["pgrep", "-f", "wineserver"], stdout=subprocess.DEVNULL)
        if reaper.returncode != 0 and wine_init.returncode != 0 and (time.time() - start_wait > 20):
            if game:
                break
            if time.time() - start_wait > 35:
                break

    # 5. Surgical in-game memory reduction for steamwebhelper (headless only)
    constrain_headless_cef()

    # 6. Enter persistent dashboard monitor
    show_dashboard(appid)

def open_steam_gui():
    """Launch Steam with full GUI, wait for user to close the window, then reclaim RAM."""
    import time
    cleanup_stale_steam_locks()

    # 1. Uncap memory limit on steam-cef.slice so GUI is never throttled
    uid = os.getuid()
    cgroup_high = f"/sys/fs/cgroup/user.slice/user-{uid}.slice/user@{uid}.service/app.slice/steam-cef.slice/memory.high"
    if os.path.isfile(cgroup_high):
        try:
            with open(cgroup_high, "w") as f:
                f.write("max\n")
        except Exception:
            pass

    # 2. If no game is running and headless Steam is active, restart Steam to enable full GPU & Millennium
    if not get_running_steam_game():
        res = subprocess.run(["pgrep", "-x", "steam"], stdout=subprocess.DEVNULL)
        if res.returncode == 0:
            print("Restarting Steam in full GUI mode with GPU acceleration & Millennium...")
            subprocess.run([REAL_STEAM, "-shutdown"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            for _ in range(10):
                time.sleep(0.5)
                if subprocess.run(["pgrep", "-x", "steam"], stdout=subprocess.DEVNULL).returncode != 0:
                    break
            cleanup_stale_steam_locks()

    # Get active workspace id
    ws_id = "1"
    try:
        ws_out = subprocess.check_output(['hyprctl', '-j', 'activeworkspace'], stderr=subprocess.DEVNULL).decode('utf-8')
        ws_id = str(json.loads(ws_out).get('id', 1))
    except Exception:
        pass

    print("Launching Steam GUI (Store/Community mode)...")
    cleanup_stale_steam_locks()
    subprocess.Popen([REAL_STEAM], env=get_steam_env(headless=False), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

    # Wait for window to appear
    steam_addr = None
    for _ in range(40):
        time.sleep(0.5)
        try:
            out = subprocess.check_output(['hyprctl', '-j', 'clients'], stderr=subprocess.DEVNULL).decode('utf-8')
            for c in json.loads(out):
                if c.get('class') == 'steam' and c.get('title') == 'Steam':
                    steam_addr = c.get('address')
                    break
        except Exception:
            pass
        if steam_addr:
            break

    if not steam_addr:
        return

    # Move to current workspace and focus
    subprocess.run(['hyprctl', 'dispatch', 'movetoworkspace', f'{ws_id},address:{steam_addr}'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(['hyprctl', 'dispatch', 'focuswindow', f'address:{steam_addr}'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    print("\033[1;32mGUI active.\033[0m Close the Steam window when done to reclaim RAM...")
    # Poll until user closes the Steam window in Hyprland
    while True:
        time.sleep(1.5)
        try:
            out = subprocess.check_output(['hyprctl', '-j', 'clients'], stderr=subprocess.DEVNULL).decode('utf-8')
            still_open = any(c.get('address') == steam_addr for c in json.loads(out))
            if not still_open:
                if not get_running_steam_game():
                    print("\033[1;33mSteam GUI closed. Shutting down Chromium/CEF processes to reclaim RAM...\033[0m")
                    subprocess.run([REAL_STEAM, "-shutdown"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                break
        except Exception:
            break

def print_help():
    print("""Usage: steam-tui-backend [OPTION]

Options:
  --list                            List all installed, shortcut, and owned games (fzf format)
  --sync                            Synchronize owned games cache from Steam data/API
  --preview <id> [st]               Show game details, Kitty preview, runtime, & cloud status
  --launch <id> [shortcut_id]       Launch game or shortcut silently
  --install <id>                    Headless installation for AppID (EULA bypass)
  --uninstall <id>                  Uninstall game AppID from terminal
  --track-update <id>               Track update/download in terminal without opening Steam GUI
  --dashboard [id]                  Show interactive session dashboard for running game
  --auto-shutdown <id>              Detached background worker for prefix & cloud sync teardown
  --has-running                     Check if a Steam game is actively running (exit code 0/1)
  --status                          Print JSON status of running game
  --launch-and-monitor <id> [sc_id] Launch game and persistently monitor session
  --edit-launch-options <id>        Configure per-game launch options in localconfig.vdf
  --set-proton <id>                 Select per-game Proton/GE compatibility tool
  --files-menu <id>                 Direct prefix, save-data, and winecfg manager
  --open-gui                        Open Steam GUI and reclaim RAM on window close
  --help                            Show this help message
""")

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print_help()
        sys.exit(0)

    arg = sys.argv[1]
    if arg == "--list":
        out = list_games()
        if out:
            print(out)
    elif arg == "--sync":
        sync_library()
        print("Sync complete.")
    elif arg == "--preview":
        if len(sys.argv) < 3:
            sys.stderr.write("Error: --preview requires <appid>\n")
            sys.exit(1)
        appid = sys.argv[2]
        status = sys.argv[3] if len(sys.argv) > 3 else None
        show_preview(appid, status)
    elif arg == "--launch":
        if len(sys.argv) < 3:
            sys.stderr.write("Error: --launch requires <appid>\n")
            sys.exit(1)
        shortcut_id = sys.argv[3] if len(sys.argv) > 3 else None
        launch_app(sys.argv[2], shortcut_id)
    elif arg == "--install":
        if len(sys.argv) < 3:
            sys.stderr.write("Error: --install requires <appid>\n")
            sys.exit(1)
        track_update(sys.argv[2], is_new_install=True)
    elif arg == "--uninstall":
        if len(sys.argv) < 3:
            sys.stderr.write("Error: --uninstall requires <appid>\n")
            sys.exit(1)
        uninstall_app(sys.argv[2])
    elif arg == "--track-update":
        if len(sys.argv) < 3:
            sys.stderr.write("Error: --track-update requires <appid>\n")
            sys.exit(1)
        track_update(sys.argv[2], is_new_install=False)
    elif arg == "--has-running":
        game = get_running_steam_game()
        sys.exit(0 if game else 1)
    elif arg == "--dashboard":
        target = sys.argv[2] if len(sys.argv) > 2 else None
        code = show_dashboard(target)
        sys.exit(code if code is not None else 0)
    elif arg == "--auto-shutdown":
        appid = sys.argv[2] if len(sys.argv) > 2 else None
        auto_shutdown_watcher(appid)
        sys.exit(0)
    elif arg == "--status":
        game = get_running_steam_game()
        print(json.dumps(game, indent=2) if game else "null")
    elif arg == "--launch-and-monitor":
        if len(sys.argv) < 3:
            sys.stderr.write("Error: --launch-and-monitor requires <appid>\n")
            sys.exit(1)
        shortcut_id = sys.argv[3] if len(sys.argv) > 3 else None
        launch_and_monitor(sys.argv[2], shortcut_id)
    elif arg == "--edit-launch-options":
        if len(sys.argv) < 3:
            sys.stderr.write("Error: --edit-launch-options requires <appid>\n")
            sys.exit(1)
        edit_launch_options(sys.argv[2])
    elif arg == "--set-proton":
        if len(sys.argv) < 3:
            sys.stderr.write("Error: --set-proton requires <appid>\n")
            sys.exit(1)
        set_proton_tool(sys.argv[2])
    elif arg == "--files-menu":
        if len(sys.argv) < 3:
            sys.stderr.write("Error: --files-menu requires <appid>\n")
            sys.exit(1)
        files_menu(sys.argv[2])
    elif arg == "--open-gui":
        open_steam_gui()
    else:
        sys.stderr.write(f"Unknown argument: {arg}\n")
        print_help()
        sys.exit(1)

if __name__ == "__main__":
    main()
